# Supabase (nunca commitear secrets reales)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (no van aquí para el cliente; se configuran en Supabase)
# Dashboard → Authentication → Providers → Google
#   Client ID = ...Google OAuth Client ID
#   Client Secret = ...Google OAuth Client secret
# Redirect URLs (Supabase URL → Configuration → Authentication → Redirect URLs):
#   http://localhost:3000/auth/callback
#   https://<tu-dominio-vercel>/auth/callback
# Google Cloud Console → Authorized redirect URIs:
#   https://<project-ref>.supabase.co/auth/v1/callback
